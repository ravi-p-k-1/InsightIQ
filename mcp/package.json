{
  "name": "insightiq-mcp",
  "version": "1.0.1",
  "description": "MCP server for looking up real FRED (Federal Reserve Economic Data) series and their historical observations.",
  "type": "module",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravi-p-k-1/InsightIQ.git",
    "directory": "mcp"
  },
  "mcpName": "io.github.ravi-p-k-1/insightiq",
  "bin": {
    "insightiq-mcp": "src/server.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "eval:contract": "node --env-file=.env evals/toolContract.js",
    "eval:retrieval": "node --env-file=.env evals/retrievalRecall.js",
    "eval:retrieval:smart": "node --env-file=.env evals/retrievalRecallSmart.js",
    "eval": "npm run eval:contract && npm run eval:retrieval && npm run eval:retrieval:smart"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
